#version 440
// N3.3 (D16 choice C): the core's clear kernel. QRhi has no buffer clear, so a storage buffer is zeroed by this dispatch
// at its allocation edge only (compute_passes.h), never per frame. The groups are capped; each invocation strides over
// the range.
layout(local_size_x = 256) in;

layout(std140, binding = 0) uniform StorageKernel {
    uint uDstWord;
    uint uSrcWord;
    uint uWords;
    uint uValue;
};

layout(std430, binding = 1) writeonly buffer StorageDst {
    uint dstWords[];
};

void main()
{
    uint stride = gl_NumWorkGroups.x * 256u;
    for (uint i = gl_GlobalInvocationID.x; i < uWords; i += stride)
        dstWords[uDstWord + i] = uValue;
}
