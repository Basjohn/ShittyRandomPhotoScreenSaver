    int uSpecMode;
    vec3 uForward;
    vec2 uFloorGiveLook;
    vec4 uFieldOrigin;
    float uFieldSide;
    vec4 uGradeStops[6];
    vec4 uGrade;
    vec2 uBodySpan;
    vec4 uBodyShape;
